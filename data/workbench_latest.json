  "hypotheses": [
    {
      "id": "F01",
      "title": "主线延续性",
      "status": "研究中",
      "description": "弱市场提前表现的科技方向，在次日强修复时，其核心连板和低位补涨是否显著优于非主线。"
    },
    {
      "id": "F02",
      "title": "巨量换手晋级",
      "status": "研究中",
      "description": "低位主线补涨第一次晋级后，次日深度分歧重新收复前高后的表现。"
    },
    {
      "id": "F03",
      "title": "极端竞价",
      "status": "研究中",
      "description": "比较0-3%、3-5%、5-7%、7-9%、直接涨停竞价与晋级/兑现关系。"
    },
    {
      "id": "F04",
      "title": "T/R脱钩",
      "status": "研究中",
      "description": "产业趋势强不等于连板接力同步强。"
    },
    {
      "id": "F05",
      "title": "低于预期竞价+板块修复",
      "status": "研究中",
      "description": "竞价略低于冻结标准，但板块持续加强后个股完成转强晋级。"
    },
    {
      "id": "F06",
      "title": "竞价倒U型假设",
      "status": "研究中",
